{
  "name": "written-journal",
  "version": "1.0.1",
  "description": "Written — futures trading journal, desktop edition (macOS + Windows)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:renderer": "node scripts/build-renderer.js",
    "verify:renderer": "node scripts/build-renderer.js --check",
    "sync": "node scripts/sync.js",
    "test:smoke": "npm run verify:renderer && playwright test",
    "prepack": "npm run verify:renderer",
    "dist": "npm run verify:renderer && electron-builder",
    "dist:mac": "npm run verify:renderer && electron-builder --mac --config.directories.output=dist/macOS",
    "dist:win": "npm run verify:renderer && electron-builder --win --config.directories.output=dist/Windows"
  },
  "author": "Kenneth Nguyen",
  "license": "MIT",
  "homepage": "https://github.com/vurelix/written",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vurelix/written.git"
  },
  "bugs": {
    "url": "https://github.com/vurelix/written/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.written.journal",
    "productName": "Written",
    "files": [
      "main.js",
      "preload.js",
      "ipc-channels.js",
      "renderer/**/*"
    ],
    "afterPack": "build/afterPack.js",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ]
  }
}
