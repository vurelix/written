{
  "name": "written-journal",
  "version": "1.0.0",
  "description": "Written — futures trading journal, desktop edition (macOS + Windows)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:renderer": "node scripts/build-renderer.js",
    "verify:renderer": "node scripts/build-renderer.js --check",
    "sync": "node scripts/sync.js",
    "prepack": "npm run verify:renderer",
    "dist": "npm run verify:renderer && electron-builder",
    "dist:mac": "npm run verify:renderer && electron-builder --mac --config.directories.output=dist/macOS",
    "dist:win": "npm run verify:renderer && electron-builder --win --config.directories.output=dist/Windows"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.written.journal",
    "productName": "Written",
    "files": [
      "main.js",
      "preload.js",
      "ipc-channels.js",
      "renderer/**/*"
    ],
    "afterPack": "build/afterPack.js",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
